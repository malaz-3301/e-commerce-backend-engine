{
  "info": {
    "name": "Book E-commerce Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "loginUsername", "value": "admin@example.com" },
    { "key": "loginPassword", "value": "admin123" },
    { "key": "userId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "bookId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "reviewId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{loginUsername}}\",\n  \"password\": \"{{loginPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Malaz Ahmad\",\n  \"email\": \"malaz@example.com\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/users"
          }
        },
        { "name": "Get Users", "request": { "method": "GET", "url": "{{baseUrl}}/users" } },
        { "name": "Get User By Id", "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}" } },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated User\",\n  \"email\": \"updated@example.com\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" } }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Programming\"\n}" },
            "url": "{{baseUrl}}/categories"
          }
        },
        { "name": "Get Categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } },
        { "name": "Get Category By Id", "request": { "method": "GET", "url": "{{baseUrl}}/categories/{{categoryId}}" } },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Software Engineering\"\n}" },
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        { "name": "Delete Category", "request": { "method": "DELETE", "url": "{{baseUrl}}/categories/{{categoryId}}" } }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"description\": \"A book about writing clean code\",\n  \"price\": 35.50,\n  \"stockQuantity\": 10,\n  \"categoryId\": {{categoryId}}\n}" },
            "url": "{{baseUrl}}/books"
          }
        },
        { "name": "Get Books", "request": { "method": "GET", "url": "{{baseUrl}}/books" } },
        { "name": "Get Book By Id", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" } },
        { "name": "Delete Book", "request": { "method": "DELETE", "url": "{{baseUrl}}/books/{{bookId}}" } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"items\": [\n    {\n      \"bookId\": {{bookId}},\n      \"quantity\": 2\n    }\n  ]\n}" },
            "url": "{{baseUrl}}/orders"
          }
        },
        { "name": "Get Orders", "request": { "method": "GET", "url": "{{baseUrl}}/orders" } },
        { "name": "Update Order Status", "request": { "method": "PUT", "url": "{{baseUrl}}/orders/{{orderId}}/status?status=CONFIRMED" } }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"bookId\": {{bookId}},\n  \"rating\": 5,\n  \"comment\": \"Excellent book\"\n}" },
            "url": "{{baseUrl}}/reviews"
          }
        },
        { "name": "Get Reviews", "request": { "method": "GET", "url": "{{baseUrl}}/reviews" } },
        { "name": "Delete Review", "request": { "method": "DELETE", "url": "{{baseUrl}}/reviews/{{reviewId}}" } }
      ]
    }
  ]
}
